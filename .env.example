# Copy to .env and edit. .env is git-ignored: never commit real credentials.

# synthetic | opensky | replay
MINIAIR_SOURCE=synthetic

# Live data area: lamin,lomin,lamax,lomax. Up to 25 square degrees costs 1 credit per call.
MINIAIR_BBOX=50.5,-2.5,53.0,1.5
MINIAIR_POLL_INTERVAL_S=30

# Optional OpenSky API client (from your OpenSky account page). Without these,
# access is anonymous: 400 credits a day, about 3 hours at one poll every 30 s.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Separation minima and prediction horizon
MINIAIR_HORIZONTAL_NM=5
MINIAIR_VERTICAL_FT=1000
MINIAIR_LOOK_AHEAD_S=120
MINIAIR_MIN_ALTITUDE_FT=1000
